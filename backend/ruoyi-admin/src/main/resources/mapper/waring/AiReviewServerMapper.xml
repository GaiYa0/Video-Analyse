<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.AiReviewServerMapper">

    <resultMap id="AiReviewServerResult" type="com.ruoyi.waring.domain.AiReviewServer">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="serverType" column="server_type"/>
        <result property="endpointUrl" column="endpoint_url"/>
        <result property="model" column="model"/>
        <result property="apiKey" column="api_key"/>
        <result property="timeoutMs" column="timeout_ms"/>
        <result property="enabled" column="enabled"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectFirstEnabled" resultMap="AiReviewServerResult">
        SELECT id,
               name,
               server_type,
               endpoint_url,
               model,
               api_key,
               timeout_ms,
               enabled,
               remark,
               create_time,
               update_time
        FROM ai_review_server
        WHERE enabled = 1
        ORDER BY id ASC
        LIMIT 1
    </select>

    <select id="selectEnabledById" resultMap="AiReviewServerResult">
        SELECT id,
               name,
               server_type,
               endpoint_url,
               model,
               api_key,
               timeout_ms,
               enabled,
               remark,
               create_time,
               update_time
        FROM ai_review_server
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>
</mapper>