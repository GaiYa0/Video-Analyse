<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.SvaServerMapper">

    <resultMap id="SvaServerResult" type="com.ruoyi.waring.domain.SvaServer">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="app" column="app"/>
        <result property="host" column="host"/>
        <result property="analyzer_port" column="analyzer_port"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

    <select id="selectEnabledById" resultMap="SvaServerResult">
        SELECT
            id,
            name,
            app,
            host,
            analyzer_port,
            enabled
        FROM sva_server
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>

    <select id="selectEnabledList" resultMap="SvaServerResult">
        SELECT
            id,
            name,
            app,
            host,
            analyzer_port,
            enabled
        FROM sva_server
        WHERE enabled = 1
        ORDER BY id ASC
    </select>
</mapper>
