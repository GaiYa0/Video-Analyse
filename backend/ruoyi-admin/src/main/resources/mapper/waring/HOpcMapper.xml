<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.HOpcMapper">

    <resultMap type="com.ruoyi.waring.domain.HOpc" id="HOpcResult">
        <result property="o_id" column="o_id"/>
        <result property="o_node" column="o_node"/>
        <result property="device_name" column="device_name"/>
        <result property="device_index" column="device_index"/>
        <result property="type" column="type"/>
    </resultMap>

    <sql id="selectHOpcVo">
        SELECT
            o_id,
            o_node,
            device_name,
            device_index,
            type
        FROM
            h_opc
    </sql>

    <select id="getStatus" >
        SELECT o_node FROM h_opc where device_index = #{device_index} AND type = #{type};
    </select>
</mapper>