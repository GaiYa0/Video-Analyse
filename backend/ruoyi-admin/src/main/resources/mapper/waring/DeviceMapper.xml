<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.DeviceMapper">

    <resultMap type="com.ruoyi.waring.domain.Device" id="DeviceResult">
        <result property="device_name" column="device_name"/>
        <result property="device_id" column="device_id"/>
    </resultMap>
    <select id="getDeviceId">
        select device_id from device where device_name = #{device_name}
    </select>
</mapper>