<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.AiReviewResultMapper">

    <resultMap id="AiReviewResultMap" type="com.ruoyi.waring.domain.AiReviewResult">
        <result property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="wId" column="w_id"/>
        <result property="decision" column="decision"/>
        <result property="confidence" column="confidence"/>
        <result property="falsePositiveScore" column="false_positive_score"/>
        <result property="summary" column="summary"/>
        <result property="reason" column="reason"/>
        <result property="rawResponseJson" column="raw_response_json"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertResult" parameterType="com.ruoyi.waring.domain.AiReviewResult" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO h_alarm_review_result (
            task_id,
            w_id,
            decision,
            confidence,
            false_positive_score,
            summary,
            reason,
            raw_response_json,
            create_time
        ) VALUES (
            #{taskId},
            #{wId},
            #{decision},
            #{confidence},
            #{falsePositiveScore},
            #{summary},
            #{reason},
            #{rawResponseJson},
            #{createTime}
        )
    </insert>

    <select id="selectLatestByWarningId" resultMap="AiReviewResultMap">
        SELECT id,
               task_id,
               w_id,
               decision,
               confidence,
               false_positive_score,
               summary,
               reason,
               raw_response_json,
               create_time
        FROM h_alarm_review_result
        WHERE w_id = #{wId}
        ORDER BY id DESC
        LIMIT 1
    </select>
</mapper>