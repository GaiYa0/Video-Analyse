<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.ZlmServerMapper">

    <resultMap id="ZlmServerResult" type="com.ruoyi.waring.domain.ZlmServer">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="app" column="app"/>
        <result property="host" column="host"/>
        <result property="api_port" column="api_port"/>
        <result property="media_http_port" column="media_http_port"/>
        <result property="media_rtsp_port" column="media_rtsp_port"/>
        <result property="secret" column="secret"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

    <select id="selectEnabledById" resultMap="ZlmServerResult">
        SELECT
            id,
            name,
            app,
            host,
            api_port,
            media_http_port,
            media_rtsp_port,
            secret,
            enabled
        FROM zlm_server
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>

    <select id="selectEnabledList" resultMap="ZlmServerResult">
        SELECT
            id,
            name,
            app,
            host,
            api_port,
            media_http_port,
            media_rtsp_port,
            secret,
            enabled
        FROM zlm_server
        WHERE enabled = 1
        ORDER BY id ASC
    </select>
</mapper>
